# ==============================================================
# Meta WhatsApp Business Cloud API Credentials
# ==============================================================
# Generate a permanent system user token in Meta Business Settings:
# https://business.facebook.com/settings -> System Users -> Generate Token
# Required permissions: whatsapp_business_messaging, whatsapp_business_management
WHATSAPP_TOKEN=your_meta_system_user_access_token

# Found in Meta Developer Console -> WhatsApp -> API Setup -> From:
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# (Optional) Found in Meta Developer Console -> WhatsApp -> API Setup.
# If provided, wa-voice will automatically register the webhook with Meta!
WHATSAPP_WABA_ID=your_whatsapp_business_account_id

# (Optional) Found in Meta Developer Console -> App Settings -> Basic -> App Secret.
# Used for HMAC-SHA256 signature verification (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=your_meta_app_secret

# (Optional) Custom verification token for GET /webhook challenge. Auto-generated if omitted.
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token

# ==============================================================
# AI Provider Keys
# ==============================================================
# For zero-friction, native speech-to-speech with Gemini 2.0 Flash Live (~300ms latency)
GEMINI_API_KEY=your_gemini_api_key

# (Optional) For alternative LLMs or custom Pipecat pipelines
# OPENAI_API_KEY=your_openai_api_key
